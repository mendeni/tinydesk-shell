# TinyDesk Shell for the ESP32-C6 (8 MB flash), ESP-IDF 5.3.1
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ESP32-C6 maximum application CPU frequency.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# ESP32-C6 built-in USB Serial/JTAG is the primary interactive console.
# This routes stdin/stdout/stderr to native USB and leaves UART0 unused by tdsh.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Networking headroom while keeping enough RAM for SSH on the no-PSRAM C6.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Required by the SMB mapped-drive VFS (ls/cd/stat/mkdir/rename, etc.).
CONFIG_VFS_SUPPORT_DIR=y

# Board wiring (RS-485, W6100 Ethernet, SD card) is not configured here:
# see board.example.conf and the `board` command.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# SD card (sd mount): FAT with long file names in UTF-8, the name buffer on
# the heap only while a call runs.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
